# 파일 위치: C:\light_sync\routes\project.py
from flask import Blueprint, render_template, request, redirect, url_for, session, flash
import datetime
from sqlalchemy.orm import joinedload
from modules.models import SessionLocal, Project, Material, HistoryLog, SportsModule, Contact

project_bp = Blueprint('project', __name__)

# -------------------------------------------------------------------
# 1. 📐 설계관리 리스트 (기존 전체 현장 리스트)
# -------------------------------------------------------------------
@project_bp.route('/project_list')
def project_list():
    if 'user_id' not in session: return redirect(url_for('auth.login'))
    db = SessionLocal()
    # 모든 현장을 불러오되, 리스트에서 품목 요약을 보여주기 위해 materials 미리 로드
    projects = db.query(Project).options(joinedload(Project.materials)).all()
    db.close()
    return render_template('project_list.html', projects=projects)

# -------------------------------------------------------------------
# 2. 📋 계약관리 리스트 (is_contracted == True 필터링)
# -------------------------------------------------------------------
@project_bp.route('/contract_list')
def contract_list():
    if 'user_id' not in session: return redirect(url_for('auth.login'))
    db = SessionLocal()
    # 계약 전환된 현장만 조회
    projects = db.query(Project).filter(Project.is_contracted == True).options(joinedload(Project.materials)).all()
    db.close()
    return render_template('contract_list.html', projects=projects)

# -------------------------------------------------------------------
# 3. 계약 현장 전환 기능
# -------------------------------------------------------------------
@project_bp.route('/convert_to_contract/<int:project_id>')
def convert_to_contract(project_id):
    if 'user_id' not in session: return redirect(url_for('auth.login'))
    db = SessionLocal()
    p = db.query(Project).get(project_id)
    if p:
        p.is_contracted = True
        p.contract_date = datetime.date.today()
        # 전환 이력 기록
        db.add(HistoryLog(project_id=project_id, user_name="시스템 🤖", 
                          content=f"{session.get('full_name')}님이 계약 관리 리스트로 전환하였습니다."))
        db.commit()
        flash(f"✅ [{p.temp_name}] 현장이 계약 관리 리스트로 전환되었습니다.", "success")
    db.close()
    return redirect(url_for('project.contract_list'))

# -------------------------------------------------------------------
# 4. 설계 현장 등록 (불필요 필드 제거 버전)
# -------------------------------------------------------------------
@project_bp.route('/project_create', methods=['GET', 'POST'])
def project_create():
    if 'user_id' not in session: return redirect(url_for('auth.login'))
    db = SessionLocal()
    if request.method == 'POST':
        try:
            year = str(datetime.date.today().year)
            count = db.query(Project).filter(Project.project_no.like(f"{year}-%")).count()
            # 사장님 요청: 약칭, 긴급 필드 제거 반영
            new_p = Project(
                project_no=f"{year}-{(count + 1):03d}",
                temp_name=request.form.get('temp_name'),
                site_address=request.form.get('site_address'),
                shipping_address=request.form.get('shipping_address'),
                site_memo=request.form.get('site_memo')
            )
            db.add(new_p); db.flush()
            
            # 초기 품목 등록 (복수 등록 지원)
            for cat, pre in [("💡 조명기구", "light"), ("🗼 조명타워", "tower")]:
                models = request.form.getlist(f'{pre}_model[]')
                qtys = request.form.getlist(f'{pre}_qty[]')
                for m, q in zip(models, qtys):
                    if m.strip():
                        qty_int = int(q) if q and q.isdigit() else 0
                        db.add(Material(project_id=new_p.id, category=cat, model_name=m, quantity=str(qty_int)))
            
            db.commit()
            return redirect(url_for('project.project_list'))
        except Exception as e:
            db.rollback(); flash(f"등록 실패: {e}", "danger")
    db.close()
    return render_template('project_create.html')

# -------------------------------------------------------------------
# 5. 상세 페이지 진입점 (설계 / 계약 분리)
# -------------------------------------------------------------------
@project_bp.route('/project_detail/<int:project_id>', methods=['GET', 'POST'])
def project_detail(project_id):
    if 'user_id' not in session: return redirect(url_for('auth.login'))
    return handle_detail_common(project_id, 'project_detail.html')

@project_bp.route('/contract_detail/<int:project_id>', methods=['GET', 'POST'])
def contract_detail(project_id):
    if 'user_id' not in session: return redirect(url_for('auth.login'))
    return handle_detail_common(project_id, 'contract_detail.html')

# -------------------------------------------------------------------
# 💡 핵심 로직: 상세페이지 공통 처리 함수 (정밀 로깅 및 수정 보강)
# -------------------------------------------------------------------
def handle_detail_common(project_id, template_name):
    db = SessionLocal()
    current_user = session.get('full_name')
    user_group = session.get('user_group')

    # DetachedInstanceError 방지 및 관계 데이터 즉시 로딩
    p = db.query(Project).options(
        joinedload(Project.materials),
        joinedload(Project.contacts),
        joinedload(Project.history_logs)
    ).filter(Project.id == project_id).first()

    if request.method == 'POST':
        action = request.form.get('action')
        
        # 💡 [A] 설계 기준 수정 (로그 보강)
        if action == 'update_design_basis':
            old_basis = p.design_basis or '미입력'
            new_basis = request.form.get('design_basis')
            reason = request.form.get('edit_reason')
            if old_basis != new_basis:
                db.add(HistoryLog(project_id=project_id, user_name="시스템 🤖", 
                                  content=f"{current_user}님이 설계기준 수정 (사유: {reason})\n변경 전: {old_basis}"))
                p.design_basis = new_basis
                db.commit()

        # 💡 [B] 작업 경로 수정
        elif action == 'update_work_path':
            new_path = request.form.get('work_path')
            if p.work_path != new_path:
                db.add(HistoryLog(project_id=project_id, user_name="시스템 🤖", 
                                  content=f"{current_user}님이 작업경로 업데이트: {new_path}"))
                p.work_path = new_path
                db.commit()

        # [C] 현장 기본 정보 수정
        elif action == 'update_project':
            p.temp_name = request.form.get('temp_name')
            p.site_address = request.form.get('site_address')
            p.shipping_address = request.form.get('shipping_address')
            p.site_memo = request.form.get('site_memo')
            db.add(HistoryLog(project_id=project_id, user_name="시스템 🤖", content=f"{current_user}님이 현장 정보를 수정했습니다."))
            db.commit()

        # 💡 [D] 담당자 추가/삭제 (로그 보강)
        elif action == 'add_contact':
            new_con = Contact(
                project_id=project_id,
                name=request.form.get('name'),
                phone=request.form.get('phone'),
                email=request.form.get('email'),
                category=request.form.get('contact_category')
            )
            db.add(new_con)
            db.add(HistoryLog(project_id=project_id, user_name="시스템 🤖", 
                              content=f"{current_user}님이 담당자 추가: {new_con.name}({new_con.category})"))
            db.commit()

        elif action == 'delete_contact':
            cid = request.form.get('contact_id')
            reason = request.form.get('delete_reason')
            con = db.query(Contact).get(int(cid))
            if con:
                db.add(HistoryLog(project_id=project_id, user_name="시스템 🤖", 
                                  content=f"{current_user}님이 담당자[{con.name}] 삭제 (사유: {reason})"))
                db.delete(con)
                db.commit()

        # 💡 [E] 자재 추가/삭제/수정 (수정 전후 로그 및 사용자 명시)
        elif action == 'add_material':
            new_mat = Material(
                project_id=project_id,
                category=request.form.get('category'), 
                model_name=request.form.get('model_name'), 
                quantity=request.form.get('quantity')
            )
            db.add(new_mat)
            db.add(HistoryLog(project_id=project_id, user_name="시스템 🤖", 
                              content=f"{current_user}님이 품목 추가: {new_mat.category}({new_mat.model_name}) {new_mat.quantity}개"))
            db.commit()

        elif action == 'delete_material':
            mid = request.form.get('material_id')
            mat = db.query(Material).get(int(mid))
            if mat:
                db.add(HistoryLog(project_id=project_id, user_name="시스템 🤖", 
                                  content=f"{current_user}님이 자재 삭제: {mat.category}({mat.model_name})"))
                db.delete(mat)
                db.commit()

        elif action == 'update_material':
            mat = db.query(Material).get(int(request.form.get('material_id')))
            if mat:
                old_info = f"{mat.model_name}({mat.quantity})"
                new_m, new_q = request.form.get('model_name'), request.form.get('quantity')
                
                # 내용이 변경되었을 때만 로그 남김
                if mat.model_name != new_m or mat.quantity != new_q:
                    db.add(HistoryLog(project_id=project_id, user_name="시스템 🤖", 
                                      content=f"{current_user}님이 품목 수정: {mat.category}\n변경 전: {old_info} ➡️ 변경 후: {new_m}({new_q})"))
                    mat.model_name, mat.quantity = new_m, new_q
                
                # 계약관리일 때만 부서별 상태 업데이트
                if "contract" in template_name:
                    for dept, col in [('영업', 'status_sales'), ('관리', 'status_admin'), ('생산', 'status_prod')]:
                        if user_group == f"{dept}부" or session.get('role') == 'admin':
                            setattr(mat, col, request.form.get(col))
                
                db.commit()

        # [추가] 담당자 코멘트
        elif action == 'add_chat':
            db.add(HistoryLog(project_id=project_id, user_name=current_user, content=request.form.get('chat_message')))
            db.commit()

        redirect_to = "project.contract_detail" if "contract" in template_name else "project.project_detail"
        return redirect(url_for(redirect_to, project_id=project_id))

    history = db.query(HistoryLog).filter(HistoryLog.project_id == project_id).order_by(HistoryLog.created_at.desc()).all()
    lux_data = db.query(SportsModule).filter(SportsModule.project_id == project_id).order_by(SportsModule.id.desc()).first()
    db.close()
    return render_template(template_name, project=p, history=history, lux=lux_data)